<%- include('../partials/shell-start', { crumbs: [{ label: 'Storage', href: '/storage' }, { label: 'Connect' }] }) %>

<div class="page-head">
  <div>
    <h1>Connect storage</h1>
    <p>Pick a provider. The endpoint, region list and public URL are filled in for you, so all you paste is a bucket name and a key pair.</p>
  </div>
  <a class="btn" href="/storage"><%- icon('chevronRight') %>Back to storage</a>
</div>

<div class="provider-cards">
  <% providers.forEach(function (p) { %>
    <a class="panel provider-card" href="/storage/new/<%= p.id %>">
      <span class="provider-logo-wrap"><%- logo(p.id) %></span>
      <span class="provider-name">
        <strong><%= p.label %></strong>
        <small><%= p.product %></small>
      </span>
      <span class="provider-blurb"><%= p.blurb %></span>
      <span class="provider-facts">
        <span class="fact">
          <%- icon('database') %>
          <%= p.regionFact || (p.regions ? p.regions.length + ' ' + p.regionLabel.toLowerCase() + (p.regions.length === 1 ? '' : 's') : 'Your own endpoint') %>
        </span>
        <span class="fact">
          <%- icon(p.supportsAcl === false ? 'info' : 'check') %>
          <%= p.supportsAcl === false ? 'Bucket-wide access' : 'Per-object ACLs' %>
        </span>
      </span>
      <span class="provider-cta">Connect<%- icon('chevronRight') %></span>
    </a>
  <% }) %>
</div>

<p class="hint mt-20">
  Every provider here speaks the S3 API, so they all work the same way once connected. Pick <strong>Other</strong> for anything not listed, including Storj, iDrive e2, OVH, Linode and Google Cloud Storage with HMAC keys.
</p>

<%- include('../partials/shell-end') %>
