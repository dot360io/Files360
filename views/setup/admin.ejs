<%- include('_start') %>
<form class="panel setup-card" method="post" action="/setup/admin">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h1>Administrator</h1>
  <p class="lead">The account you will sign in to the dashboard with. The password is stored as a bcrypt hash, never in clear.</p>
  <% if (error) { %>
    <div class="alert alert-danger field" role="alert"><%- icon('alert') %><div><%= error %></div></div>
  <% } %>
  <div class="field">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" maxlength="254" autocomplete="username" required autofocus value="<%= form.email || '' %>">
  </div>
  <div class="field">
    <label for="password">Password</label>
    <input id="password" name="password" type="password" minlength="<%= minPassword %>" autocomplete="new-password" required>
    <p class="hint">At least <%= minPassword %> characters.</p>
  </div>
  <div class="field">
    <label for="confirm">Password again</label>
    <input id="confirm" name="confirm" type="password" minlength="<%= minPassword %>" autocomplete="new-password" required>
  </div>
  <div class="setup-actions">
    <a class="btn btn-ghost" href="/setup/database">Back</a>
    <button class="btn btn-primary" type="submit">Continue</button>
  </div>
</form>
<%- include('_end') %>
