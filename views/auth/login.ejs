<%- include('../partials/head') %>
<body>
<div class="auth">
  <section class="auth-art">
    <a class="brand" href="/login"><%- include('../partials/brand') %><span><%= appName %></span></a>
    <div class="tiles" aria-hidden="true">
      <span><%- icon('image') %></span><span></span><span><%- icon('zap') %></span>
      <span></span><span><%- icon('layers') %></span><span></span>
      <span><%- icon('cloudUp') %></span><span></span><span><%- icon('code') %></span>
    </div>
    <div class="copy">
      <h2>Optimize, store and deliver images for every app.</h2>
      <p>Apps upload through one API. Images are resized, converted and served from your CDN.</p>
    </div>
    <div class="foot">Self-hosted image service</div>
  </section>

  <section class="auth-form">
    <form method="post" action="/login">
      <h1>Sign in</h1>
      <p class="lead">Use your administrator account.</p>
      <% if (error) { %>
        <div class="alert alert-danger field" role="alert"><%- icon('alert') %><div><%= error %></div></div>
      <% } %>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="username" required autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
      </div>
      <button class="btn btn-primary" type="submit">Sign in</button>
    </form>
  </section>
</div>
</body>
</html>
