{
  "name": "files360",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted upload API and media library. Images are optimized into the sizes you configure, documents are stored with a preview, and everything lands on your own S3-compatible bucket as CDN URLs.",
  "license": "AGPL-3.0-only",
  "author": "Dot360",
  "homepage": "https://files360.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dot360io/Files360.git"
  },
  "bugs": {
    "url": "https://github.com/dot360io/Files360/issues"
  },
  "keywords": [
    "cloudinary-alternative",
    "self-hosted",
    "image-optimization",
    "digital-asset-management",
    "s3",
    "file-upload-api"
  ],
  "main": "server.js",
  "scripts": {
    "test": "node --test test/",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "hash-password": "node scripts/hash-password.js",
    "check-storage": "node scripts/check-storage.js",
    "fetch-logos": "node scripts/fetch-logos.js",
    "docs:generate": "node scripts/build-docs.js",
    "docs:dev": "npm run docs:generate && vitepress dev docs",
    "docs:build": "npm run docs:generate && vitepress build docs",
    "import-cloudinary": "node scripts/import-from-cloudinary.js"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "connect-session-knex": "^5.0.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "knex": "^3.3.0",
    "multer": "^2.0.2",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
