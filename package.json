{
  "name": "files360",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted file and image API. Apps upload through one endpoint; images are optimized into every size you configure, documents are stored and previewed, everything lands on your own S3-compatible bucket and comes back as a CDN URL.",
  "main": "server.js",
  "scripts": {
    "test": "node --test test/",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "hash-password": "node scripts/hash-password.js",
    "check-storage": "node scripts/check-storage.js",
    "fetch-logos": "node scripts/fetch-logos.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.0",
    "multer": "^2.0.2",
    "sharp": "^0.34.1"
  }
}
