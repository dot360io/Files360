NODE_ENV=production
HOST=127.0.0.1
PORT=4360

# Name shown in the dashboard and in generated docs
APP_NAME=Files360
# Public base URL of this service, used in the generated integration docs
PUBLIC_URL=https://images.example.com
TIMEZONE=UTC

MONGO_URI=mongodb://127.0.0.1:27017/files360

# Long random string: openssl rand -hex 32
SESSION_SECRET=

# Encrypts bucket credentials at rest. Optional: falls back to SESSION_SECRET.
# Set it to rotate SESSION_SECRET without having to reconnect your buckets.
# openssl rand -hex 32
STORAGE_KEY=

# Dashboard login. Create the hash with: npm run hash-password -- 'your password'
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=


# Object storage is NOT configured here. Connect one or more buckets in the
# dashboard under Storage: Hetzner, DigitalOcean, AWS, Cloudflare R2, Backblaze,
# Wasabi, Scaleway, MinIO or any other S3-compatible provider.

# Hard limits for every app (per-app limits can only be lower)
MAX_UPLOAD_MB=25
MAX_INPUT_PIXELS=60000000
# How many images are processed at the same time, and how many may wait.
# Documents and archives never queue: they are stored as they arrive.
MAX_CONCURRENT_JOBS=2
MAX_QUEUE=50
# libvips threads per image
SHARP_THREADS=2
API_RATE_LIMIT_PER_MIN=120
