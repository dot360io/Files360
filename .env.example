# Everything here is optional. With no .env at all, the first start opens a
# setup wizard in the browser that chooses the database, creates the
# administrator and connects storage, then saves its answers to data/config.json.
# Anything set here takes priority over that file.

NODE_ENV=production
HOST=127.0.0.1
PORT=4360

# Name shown in the dashboard and in generated docs
APP_NAME=Files360
# Public base URL of this service, used in the generated integration docs
PUBLIC_URL=https://files.example.com
TIMEZONE=UTC

# Where config.json, secrets.json and the SQLite database live. Mount this as a volume.
# DATA_DIR=./data

# Set this and the wizard skips its database step:
#   sqlite:files360.sqlite (inside DATA_DIR), postgres://user:pass@host:5432/files360,
#   mysql://user:pass@host:3306/files360
# DATABASE_URL=

# Generated on first start and kept in DATA_DIR/secrets.json. Set them only to
# manage secrets yourself. STORAGE_KEY encrypts the stored bucket credentials:
# changing it makes them unreadable and the buckets have to be reconnected.
# SESSION_SECRET=
# STORAGE_KEY=

# Creates the first administrator when the database has none, so an unattended
# deployment never sees the wizard. Give either the password (hashed at start,
# never stored) or a bcrypt hash from: npm run hash-password -- 'your password'
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# Object storage is NOT configured here. Connect one or more buckets in the
# dashboard under Storage: Hetzner, DigitalOcean, AWS, Cloudflare R2, Backblaze,
# Wasabi, Scaleway, MinIO, Garage, SeaweedFS or any other S3-compatible provider.

# Hard limits for every app (per-app limits can only be lower)
MAX_UPLOAD_MB=25
MAX_INPUT_PIXELS=60000000
# How many images are processed at the same time, and how many may wait.
# Documents and archives never queue: they are stored as they arrive.
MAX_CONCURRENT_JOBS=2
MAX_QUEUE=50
# libvips threads per image
SHARP_THREADS=2
API_RATE_LIMIT_PER_MIN=120
